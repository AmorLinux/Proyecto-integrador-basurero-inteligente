# URL pública de la aplicación EcoSort desplegada en Vercel.
ECOSORT_API_BASE_URL=https://ecosort-kyc9iilku-drahciroks-projects.vercel.app

# Debe coincidir exactamente con DEVICE_API_KEY en Vercel.
ECOSORT_DEVICE_API_KEY=reemplaza-con-la-clave-del-dispositivo

# Activa el QR solo cuando la URL y la clave estén configuradas.
ECOSORT_QR_ENABLED=true
ECOSORT_QR_DISPLAY_SECONDS=120
